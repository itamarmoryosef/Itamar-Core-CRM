# Copy values into Vercel → Project → Settings → Environment Variables (Production + Preview).
# Do not commit real secrets. Local: copy to `.env.local`.

# --- Supabase (required everywhere) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required on Vercel for admin WhatsApp routes that read `clients` / `client_statuses`
# with full access. Without it, routes fall back to the anon key and may fail under RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Green API (WhatsApp) — required for send-document, send-license-granted-review, etc. ---
# Same values as local `.env.local` when it worked on port 3000.
GREEN_API_URL=
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=

# --- Public URLs (recommended on Vercel) ---
# Your live site, e.g. https://your-domain.vercel.app or custom domain
NEXT_PUBLIC_SITE_URL=
# Often set on Vercel alongside SITE_URL (admin / deployed origin helpers)
NEXT_PUBLIC_APP_URL=
# Optional: portal links in messages (if unset, a built-in default is used)
NEXT_PUBLIC_PORTAL_BASE_URL=

# Not used by this app — WhatsApp goes through Green API (variables above).
# WHATSAPP_BRIDGE_URL=

# --- License review WhatsApp (optional overrides) ---
# If set, overrides the default Google share link in code
LICENSE_GRANTED_REVIEW_URL=
# Pipe-separated CRM status labels, e.g. "סטטוס א|סטטוס ב"
LICENSE_GRANTED_REVIEW_STATUS_LABELS=
